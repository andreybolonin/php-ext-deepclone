+typedef struct {
+	zend_property_info *info;
+	zend_string *name;
+} dc_batch_property;
+
+PHP_FUNCTION(deepclone_hydrate_batch)
+{
+	zend_string *class_name;
+	HashTable *properties, *rows;
+	ZEND_PARSE_PARAMETERS_START(3, 3)
+		Z_PARAM_STR(class_name)
+		Z_PARAM_ARRAY_HT(properties)
+		Z_PARAM_ARRAY_HT(rows)
+	ZEND_PARSE_PARAMETERS_END();
+
+	if (UNEXPECTED(!zend_array_is_list(properties) || !zend_array_is_list(rows))) {
+		zend_value_error("deepclone_hydrate_batch(): $properties and $rows must be lists");
+		RETURN_THROWS();
+	}
+
+	zend_class_entry *ce = zend_lookup_class(class_name);
+	if (UNEXPECTED(!ce)) {
+		if (!EG(exception)) {
+			zend_throw_exception_ex(dc_ce_class_not_found_exception, 0,
+				"Class \"%s\" not found.", ZSTR_VAL(class_name));
+		}
+		RETURN_THROWS();
+	}
+	if (UNEXPECTED(ce->type != ZEND_USER_CLASS || (ce->ce_flags & ZEND_ACC_UNINSTANTIABLE)
+		|| ce->create_object || dc_refuses_serialization(ce) || dc_needs_internal_state(ce))) {
+		zend_throw_exception_ex(dc_ce_not_instantiable_exception, 0,
+			"Type \"%s\" is not supported for batch hydration.", ZSTR_VAL(ce->name));
+		RETURN_THROWS();
+	}
+
+	uint32_t property_count = zend_hash_num_elements(properties);
+	dc_batch_property *plan = property_count
+		? safe_emalloc(property_count, sizeof(dc_batch_property), 0) : NULL;
+	uint32_t planned = 0;
+	HashTable seen;
+	zend_hash_init(&seen, property_count, NULL, NULL, 0);
+	zval *key;
+	ZEND_HASH_FOREACH_VAL(properties, key) {
+		ZVAL_DEREF(key);
+		if (UNEXPECTED(Z_TYPE_P(key) != IS_STRING)) {
+			zend_value_error("deepclone_hydrate_batch(): $properties must contain only strings");
+			goto invalid_plan;
+		}
+		zend_string *name;
+		bool mangled;
+		zend_class_entry *scope = dc_resolve_hydration_key(ce, Z_STR_P(key), &name,
+			&mangled, "deepclone_hydrate_batch(): Argument #2 ($properties)");
+		if (UNEXPECTED(!scope)) {
+			goto invalid_plan;
+		}
+		zend_property_info *info = zend_hash_find_ptr(&scope->properties_info, name);
+		if (UNEXPECTED(!dc_is_backed_declared_property(info) || DC_PROP_HAS_HOOKS(info))) {
+			zend_value_error("deepclone_hydrate_batch(): $properties must target declared, backed instance properties without hooks");
+			goto invalid_plan;
+		}
+		if (UNEXPECTED(!zend_hash_index_add_empty_element(&seen, info->offset))) {
+			zend_value_error("deepclone_hydrate_batch(): $properties contains a duplicate property target");
+			goto invalid_plan;
+		}
+		plan[planned++] = (dc_batch_property) {info, zend_string_copy(name)};
+	} ZEND_HASH_FOREACH_END();
+	zend_hash_destroy(&seen);
+
+	zval result;
+	array_init_size(&result, zend_hash_num_elements(rows));
+	zval *row;
+	ZEND_HASH_FOREACH_VAL(rows, row) {
+		ZVAL_DEREF(row);
+		if (UNEXPECTED(Z_TYPE_P(row) != IS_ARRAY || !zend_array_is_list(Z_ARRVAL_P(row))
+			|| zend_hash_num_elements(Z_ARRVAL_P(row)) != property_count)) {
+			zend_value_error("deepclone_hydrate_batch(): each row must be a list matching $properties");
+			goto invalid_rows;
+		}
+		/* Keep the row alive if a coercion changes a referenced input entry. */
+		zval input;
+		ZVAL_COPY(&input, row);
+		zval object;
+		ZVAL_UNDEF(&object);
+		if (UNEXPECTED(object_init_ex(&object, ce) != SUCCESS || EG(exception))) {
+			zval_ptr_dtor(&input);
+			zval_ptr_dtor(&object);
+			goto invalid_rows;
+		}
+		uint32_t column = 0;
+		zval *item;
+		ZEND_HASH_FOREACH_VAL(Z_ARRVAL(input), item) {
+			zval value;
+			ZVAL_COPY_DEREF(&value, item);
+			dc_batch_property *property = &plan[column++];
+			bool ok = dc_write_backed_property(Z_OBJ(object), property->info, property->name, &value, 0);
+			zval_ptr_dtor(&value);
+			if (UNEXPECTED(!ok || EG(exception))) {
+				zval_ptr_dtor(&input);
+				zval_ptr_dtor(&object);
+				goto invalid_rows;
+			}
+		} ZEND_HASH_FOREACH_END();
+		zval_ptr_dtor(&input);
+		if (UNEXPECTED(EG(exception))) {
+			zval_ptr_dtor(&object);
+			goto invalid_rows;
+		}
+		add_next_index_zval(&result, &object);
+	} ZEND_HASH_FOREACH_END();
+	for (uint32_t i = 0; i < planned; i++) {
+		zend_string_release(plan[i].name);
+	}
+	if (plan) efree(plan);
+	RETURN_COPY_VALUE(&result);
+
+invalid_plan:
+	zend_hash_destroy(&seen);
+	goto fail;
+invalid_rows:
+	zval_ptr_dtor(&result);
+fail:
+	for (uint32_t i = 0; i < planned; i++) {
+		zend_string_release(plan[i].name);
+	}
+	if (plan) efree(plan);
+	RETURN_THROWS();
+}
