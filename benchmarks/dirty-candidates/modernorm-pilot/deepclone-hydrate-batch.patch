@@ -0,0 +1,57 @@
+--TEST--
+deepclone_hydrate_batch() hydrates homogeneous objects with scalar hydration semantics
+--EXTENSIONS--
+deepclone
+--FILE--
+<?php
+class BatchParent
+{
+    private int $hidden;
+    protected ?string $label = 'default';
+}
+
+final class BatchEntity extends BatchParent
+{
+    public readonly int $id;
+    public array $payload;
+    public DateTimeImmutable $createdAt;
+    public int $uninitialized;
+    public string $omitted = 'default';
+
+    public function __construct()
+    {
+        throw new LogicException('Constructor must not run');
+    }
+}
+
+$date = new DateTimeImmutable('2026-11-26');
+$id = 42;
+$keys = ['id', "\0BatchParent\0hidden", "\0*\0label", 'payload', 'createdAt', 'uninitialized'];
+$rows = [
+    [&$id, 10, null, ['colour' => 'blue'], $date, null],
+    [43, 20, 'second', ['pages' => 96], $date, null],
+];
+$expected = array_map(
+    static fn (array $row): object => deepclone_hydrate(BatchEntity::class, array_combine($keys, $row)),
+    $rows,
+);
+$actual = deepclone_hydrate_batch(BatchEntity::class, $keys, $rows);
+$id = 99;
+var_dump($actual == $expected);
+var_dump($actual[0]->id, $actual[1]->id);
+var_dump($actual[0]->createdAt === $date);
+var_dump((new ReflectionProperty(BatchEntity::class, 'uninitialized'))->isInitialized($actual[0]));
+var_dump($actual[0]->omitted);
+var_dump(deepclone_hydrate_batch(BatchEntity::class, ['id'], []));
+var_dump(count(deepclone_hydrate_batch(BatchEntity::class, [], [[], []])));
+?>
+--EXPECT--
+bool(true)
+int(42)
+int(43)
+bool(true)
+bool(false)
+string(7) "default"
+array(0) {
+}
+int(2)
