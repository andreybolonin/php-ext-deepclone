+--TEST--
+deepclone_hydrate_batch() rejects unsupported layouts and invalid rows
+--EXTENSIONS--
+deepclone
+--FILE--
+<?php
+class BatchErrors
+{
+    public int $id;
+    protected int $protected = 0;
+    public static int $static;
+    public static int $destroyed = 0;
+
+    public function __destruct()
+    {
+        if (isset($this->id)) {
+            ++self::$destroyed;
+        }
+    }
+}
+
+function verifyError(string $expected, callable $callback): void
+{
+    try {
+        $callback();
+        echo "missing exception\n";
+    } catch (Throwable $error) {
+        var_dump($error::class === $expected);
+    }
+}
+
+verifyError(DeepClone\ClassNotFoundException::class, fn () => deepclone_hydrate_batch('MissingBatchClass', [], []));
+verifyError(DeepClone\NotInstantiableException::class, fn () => deepclone_hydrate_batch(stdClass::class, [], []));
+verifyError(ValueError::class, fn () => deepclone_hydrate_batch(BatchErrors::class, [1 => 'id'], [[1]]));
+verifyError(ValueError::class, fn () => deepclone_hydrate_batch(BatchErrors::class, ['id'], [1 => [1]]));
+verifyError(ValueError::class, fn () => deepclone_hydrate_batch(BatchErrors::class, ['id'], [['id' => 1]]));
+verifyError(ValueError::class, fn () => deepclone_hydrate_batch(BatchErrors::class, ['id'], [[1, 2]]));
+verifyError(ValueError::class, fn () => deepclone_hydrate_batch(BatchErrors::class, [1], []));
+verifyError(ValueError::class, fn () => deepclone_hydrate_batch(BatchErrors::class, ['static'], []));
+verifyError(ValueError::class, fn () => deepclone_hydrate_batch(BatchErrors::class, ['missing'], []));
+verifyError(ValueError::class, fn () => deepclone_hydrate_batch(BatchErrors::class, ['protected', "\0*\0protected"], []));
+verifyError(TypeError::class, fn () => deepclone_hydrate_batch(BatchErrors::class, ['id'], [[1], [new stdClass()]]));
+var_dump(BatchErrors::$destroyed);
+?>
