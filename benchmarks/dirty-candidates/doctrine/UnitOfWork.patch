+    /**
+     * Restrict the experiment to the stock public-field accessor configuration.
+     */
+    private function auditDirtyPlan(ClassMetadata $class, array $entities): ?array
+    {
+        if (count($entities) < 64 || !$class->isChangeTrackingDeferredImplicit() || !$class->isIdentifierNatural()
+            || $class->associationMappings !== [] || $class->embeddedClasses !== [] || $class->versionField !== null
+            || !$class->isInheritanceTypeNone() || $class->reflClass?->getParentClass() !== false
+            || !$this->em->getConfiguration()->isNativeLazyObjectsEnabled()
+            || $this->partialObjectLoadedFields !== [] || $this->entityInsertions !== [] || $this->entityDeletions !== []
+            || ($this->listenersInvoker->getSubscribedSystems($class, Events::preFlush) & ~ListenersInvoker::INVOKE_MANAGER) !== 0
+        ) {
+            return null;
+        }
+
+        foreach ($class->propertyAccessors as $field => $accessor) {
+            $property = $accessor->getUnderlyingReflector();
+            if (!isset($class->fieldMappings[$field]) || $class->fieldMappings[$field]->enumType !== null
+                || !$property->isPublic() || $property->hasHooks() || $property->isReadOnly() || $property->getName() !== $field
+            ) {
+                return null;
+            }
+        }
+
+        return array_keys($class->fieldMappings);
+    }
